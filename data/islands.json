        {
          "id": "gus_lindquist",
          "name": "Gus Lindquist",
          "kind": "fisherman",
          "home": "hermit_fish_camp",
          "talk": [
            "The quarry company left in '97. Left the derrick, and the men's pay too, they say.",
            "Old Wilson lived up in that cabin alone forty years ago. Folks still say he hid his money.",
            "Nobody comes here but me and the gulls. I'd notice a stranger."
          ]
        }
      ],
      "reporting": "slow"
    }
