      ],
      "residents": [
        {
          "id": "nils_hansen",
          "name": "Nils Hansen",
          "kind": "farmer",
          "home": "sand_hansen_farm",
          "talk": [
            "Potatoes and hay, and the cow. The ground's sandy but it grows if you work it.",
            "The schoolteacher comes over from Bayfield in the fall. Seven children this year.",
            "The light keeper rows across to us for milk. He sees everything from up there."
          ]
        },
        {
          "id": "ole_johnson",
          "name": "Ole Johnson",
          "kind": "farmer",
          "home": "sand_johnson_farm",
          "talk": [
            "We came over from Norway in '85. Same lake, colder than the fjord.",
            "Strawberries in June, if the frost leaves them. Bayfield buys all we pick.",
            "A schooner lay off East Bay a week back, at night, no lights. Not mine to ask."
          ]
        },
        {
          "id": "anders_brekke",
          "name": "Anders Brekke",
          "kind": "fisherman",
          "home": "sand_east_bay_camp",
          "talk": [
            "Herring's running off the shoal. The nets come up heavy if you're out before light.",
            "The Booth boat takes our fish to Bayfield twice a week, salted in the barrel.",
            "Keep clear of the reef between here and York. It's taken better boats than yours."
          ]
        },
        {
          "id": "knut_brekke",
          "name": "Knut Brekke",
          "kind": "fisherman",
          "home": "sand_east_bay_camp",
          "round": [
            {
              "x": 560,
              "z": 380
            }
          ],
          "talk": [
            "Father says I mend nets like a girl. The nets don't complain.",
            "There are caves at the north end, full of swallows. You can row in on a flat day."
          ]
        }
      ],
      "reporting": "medium"
    }
  },
